# ── Google Earth Engine ───────────────────────────────
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=path/to/gee-key.json

# ── Open-Meteo (free, no key required) ───────────────
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── SoilGrids (ISRIC, free) ───────────────────────────
# SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# ── App Settings ─────────────────────────────────────
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Model Paths ───────────────────────────────────────
CLASSIFIER_MODEL_PATH=../ml/saved_models/lgbm_classifier.pkl
REGRESSOR_MODEL_PATH=../ml/saved_models/xgb_regressor.pkl
